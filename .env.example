# -------------------------------------------------------------
# HomeCloud Environment Configuration
# -------------------------------------------------------------

# PostgreSQL Database Configuration
POSTGRES_DB=homecloud
POSTGRES_USER=homecloud
POSTGRES_PASSWORD=your_super_secret_database_password_here
DB_PORT=5432

# Spring Boot Configuration (used for local bare-metal run)
DB_URL=jdbc:postgresql://localhost:5432/homecloud
DB_USERNAME=homecloud
DB_PASSWORD=your_super_secret_database_password_here

# JWT Security (Must be at least 32 characters in production)
JWT_SECRET=your_secure_random_jwt_secret_min_32_characters_long_12345
JWT_EXPIRATION_MS=86400000

# Docker & Reverse Proxy (Caddy) Settings
HTTP_PORT=80
HTTPS_PORT=443

# Site Address: Defaults to :80 for LAN, or set to your domain / Tailscale MagicDNS name:
# Examples:
#   SITE_ADDRESS=:80                           (Local LAN HTTP)
#   SITE_ADDRESS=homecloud.tail1234.ts.net      (Tailscale with auto HTTPS)
#   SITE_ADDRESS=cloud.yourdomain.com          (Public domain with Let's Encrypt TLS)
SITE_ADDRESS=:80

# Bare-metal local runner settings
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0
STORAGE_LOCATION=HomeCloudStorage
