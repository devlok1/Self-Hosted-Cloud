# Database Configuration (PostgreSQL)
POSTGRES_DB=homecloud
POSTGRES_USER=homecloud
POSTGRES_PASSWORD=your_secure_password_here

# Spring Boot Configuration
DB_URL=jdbc:postgresql://localhost:5432/homecloud
DB_USERNAME=homecloud
DB_PASSWORD=your_secure_password_here

# JWT Security (Must be at least 32 characters in production)
JWT_SECRET=your_secure_random_jwt_secret_min_32_characters
JWT_EXPIRATION_MS=3600000

# Server & Storage
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0
STORAGE_LOCATION=HomeCloudStorage
